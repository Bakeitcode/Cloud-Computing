{
  "Version": "2012-10-17",
  "Id": "__default_policy_ID",
  "Statement": [
    {
      "Sid": "__owner_statement",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::338893091918:root"
      },
      "Action": "SQS:*",
      "Resource": "arn:aws:sqs:us-east-1:338893091918:hw07-queue-metadata"
    },
    {
      "Sid": "topic-subscription-arn:aws:sns:us-east-1:338893091918:hw07-sns-topic",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "SQS:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:338893091918:hw07-queue-metadata",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:sns:us-east-1:338893091918:hw07-sns-topic"
        }
      }
    }
  ]
}